{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"paths": {
			"@win-mgr/core": ["../../packages/core/src/index.ts"],
			"react-win-mgr": ["../../packages/react/src/index.ts"]
		}
	},
	"include": ["src"]
}

{
	"name": "react-win-mgr",
	"version": "0.1.0",
	"description": "A Blender-style tiling window manager for React. Frames split, merge and resize with no gaps and no overlaps.",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/style.css"
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "vite build",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@win-mgr/core": "0.1.0"
	},
	"devDependencies": {
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.77.0",
		"typescript": "^5.4.0",
		"vite": "^5.2.0",
		"vite-plugin-dts": "^3.9.0"
	}
}
